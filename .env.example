# Modèle sans valeur réelle. Le dépôt est public : aucune valeur ne s'écrit ici.
# En production, ces variables sont saisies dans l'hébergement ; en local, dans
# un fichier .env non suivi.

# --- Lecture de GitHub (tranche 1a) ---
# Jeton GitHub du dashboard (secret). Lecture du dépôt suivi.
NUXT_GITHUB_TOKEN=

# Dépôt suivi, au format propriétaire/dépôt.
NUXT_GITHUB_REPO=

# --- Connexion GitHub (tranche 1b) ---
# OAuth App GitHub. L'URL de rappel est <origine>/auth/github.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Secret de scellement de la session (secret), au moins 32 caractères aléatoires.
NUXT_SESSION_PASSWORD=

# Identifiant numérique du seul compte autorisé. Public : ce n'est pas un secret.
# Le login ne sert qu'à l'affichage, car il peut être renommé puis repris.
NUXT_ALLOWED_GITHUB_ID=

# --- Inscrit dans l'image à sa construction, rien à saisir ---
APP_COMMIT=

# --- Historique des événements (tranche 5, fiches 0006 et 0007) ---
# Chemin du fichier SQLite. En production, il doit pointer dans un volume
# persistant, sans quoi l'historique disparaît à chaque redéploiement.
NUXT_BASE_FICHIER=
# Secret partagé avec le webhook GitHub de cairn-wms. Il sert à vérifier la
# signature de chaque livraison : sans lui, la route publique n'accepte rien.
NUXT_WEBHOOK_SECRET=

# --- Événements des sessions Claude Code (tranche 6, fiches 0008 et 0009) ---
# Secret partagé avec les hooks des deux dépôts suivis. Côté poste, la même
# valeur se nomme CAIRN_HOOKS_SECRET et vit dans la section « env » de
# ~/.claude/settings.json — hors de tout dépôt, en droits 600.
NUXT_HOOKS_SECRET=
