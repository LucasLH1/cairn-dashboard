# Modèle sans valeur réelle. Le dépôt est public : aucune valeur ne s'écrit ici.
# En production, ces variables sont saisies dans Coolify ; en local, dans un
# fichier .env non suivi.

# Jeton GitHub du dashboard (secret). Lecture de LucasLH1/cairn-wms.
NUXT_GITHUB_TOKEN=

# Dépôt suivi, au format propriétaire/dépôt.
NUXT_GITHUB_REPO=

# SHA inscrit dans l'image à sa construction. Rien à saisir à la main.
APP_COMMIT=
