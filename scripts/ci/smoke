#!/usr/bin/env bash
# Épreuve de l'image avant publication — docs/deploiement.md §1 et §2 :
# démarrage réel, /version rend CE SHA, /health répond 200 avec ses dépendances,
# puis 503 une fois une dépendance coupée. Un garde-fou qui ne refuse jamais
# n'est pas prouvé.
#
# Depuis la tranche 1b, on éprouve aussi la porte : sans session, une page mène
# à la connexion, et seules les routes publiques répondent.
#
#   scripts/ci/smoke <image> <sha>
#
# Variables attendues : NUXT_GITHUB_TOKEN, NUXT_GITHUB_REPO (cas nominal).
set -euo pipefail

IMAGE="${1:?image attendue}"
SHA="${2:?sha attendu}"
PORT="${SMOKE_PORT:-3010}"
NOM="smoke-$$"
BASE="http://127.0.0.1:${PORT}"

nettoyer() { docker rm -f "$NOM" >/dev/null 2>&1 || true; }
trap nettoyer EXIT

MDP_SESSION="$(head -c 48 /dev/urandom | base64 | tr -d '\n')"
ID_AUTORISE=68059501
SECRET_HOOKS="$(head -c 32 /dev/urandom | base64 | tr -d '\n')"

# Le connecteur MCP (fiche 0011) : un client connu, un secret de signature.
CLIENT_MCP="client-epreuve"
SECRET_MCP="$(head -c 48 /dev/urandom | base64 | tr -d '\n')"
RAPPEL_CLAUDE="https://claude.ai/api/mcp/auth_callback"

# Adresses de GitHub substituables en développement seulement (fiche 0010). Le
# conteneur nominal les reçoit, pointées vers une adresse où rien n'écoute :
# l'image doit les ignorer. Si elle les suivait, /health tomberait à 503 et la
# connexion ne mènerait plus chez GitHub — les deux vérifications ci-dessous le
# verraient.
LEURRE="http://127.0.0.1:9"

# Identifiants OAuth factices : ils ne servent qu'à rendre la configuration
# complète. Aucun appel n'est fait chez GitHub pendant l'épreuve.
demarrer() { # $1 = jeton de lecture, $2 = secret de session (défaut : le bon)
  nettoyer
  docker run -d --name "$NOM" -p "127.0.0.1:${PORT}:3000" \
    -e "NUXT_GITHUB_TOKEN=$1" \
    -e "NUXT_GITHUB_REPO=${NUXT_GITHUB_REPO:-}" \
    -e "NUXT_SESSION_PASSWORD=${2:-$MDP_SESSION}" \
    -e "NUXT_ALLOWED_GITHUB_ID=${ID_AUTORISE}" \
    -e "NUXT_OAUTH_GITHUB_CLIENT_ID=epreuve" \
    -e "NUXT_OAUTH_GITHUB_CLIENT_SECRET=epreuve" \
    -e "NUXT_HOOKS_SECRET=${SECRET_HOOKS}" \
    -e "NUXT_MCP_CLIENT_ID=${CLIENT_MCP}" \
    -e "NUXT_MCP_SECRET=${SECRET_MCP}" \
    -e "NUXT_GITHUB_API_URL=${LEURRE}" \
    -e "NUXT_GITHUB_WEB_URL=${LEURRE}" \
    "$IMAGE" >/dev/null
}

# Forge une session scellée comme le serveur le ferait, pour éprouver le
# garde-fou : un sceau valide ne doit pas suffire à entrer.
forger_session() { # $1 = identifiant numérique
  MDP="$MDP_SESSION" ID="$1" node --input-type=module -e '
    import { seal, defaults } from "iron-webcrypto"
    import { webcrypto } from "node:crypto"
    const id = Number(process.env.ID)
    process.stdout.write(await seal(
      webcrypto,
      { id: `epreuve-${id}`, createdAt: Date.now(), data: { id, login: "compte-eprouve" } },
      process.env.MDP,
      { ...defaults, ttl: 12 * 3600 * 1000 },
    ))
  '
}

attendre() {
  for _ in $(seq 1 60); do
    if curl -sf -m 3 -o /dev/null "${BASE}/version"; then return 0; fi
    sleep 1
  done
  echo "le conteneur ne répond pas sur ${BASE}/version"; docker logs "$NOM" | tail -20; return 1
}

verifier_code() { # $1 = chemin, $2 = code attendu, $3 = libellé
  local code
  code=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' "${BASE}$1")
  if [ "$code" != "$2" ]; then
    echo "$3 : attendu $2, obtenu $code — $(head -c 200 /tmp/smoke-corps)"
    docker logs "$NOM" | tail -20
    exit 1
  fi
  echo "   $3 : $code"
}

echo "== démarrage de l'image avec un jeton valide"
demarrer "${NUXT_GITHUB_TOKEN:?jeton attendu}"
attendre

echo "== /version rend le SHA construit"
VU=$(curl -sf -m 5 "${BASE}/version" | sed -n 's/.*"commit" *: *"\([^"]*\)".*/\1/p')
if [ "$VU" != "$SHA" ]; then echo "attendu $SHA, obtenu '${VU}'"; exit 1; fi
echo "   $VU"

echo "== /health répond 200"
verifier_code /health 200 "/health"
echo "   $(cat /tmp/smoke-corps)"

echo "== /live répond 200"
verifier_code /live 200 "/live"
echo "   $(cat /tmp/smoke-corps)"

echo "== sans session, la porte est fermée"
verifier_code / 302 "page d'accueil"
CIBLE=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' "${BASE}/")
case "$CIBLE" in
  */connexion) echo "   redirige vers $CIBLE" ;;
  *) echo "la page d'accueil devrait mener à /connexion, elle mène à '${CIBLE}'"; exit 1 ;;
esac
verifier_code /connexion 200 "écran de connexion"
verifier_code /api/moi 401 "route de données"
CIBLE=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' "${BASE}/auth/github")
case "$CIBLE" in
  https://github.com/login/oauth/authorize*) echo "   connexion configurée : part chez GitHub" ;;
  *) echo "la connexion devrait mener chez GitHub, elle mène à '${CIBLE}'"; exit 1 ;;
esac
echo "   adresses de développement reçues et ignorées : /health a lu le vrai GitHub, la connexion y mène"

echo "== un sceau valide ne suffit pas : l'identifiant est revérifié"
SESSION_AUTRE="$(forger_session 999999)"
SESSION_BONNE="$(forger_session "$ID_AUTORISE")"
CODE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_AUTRE}" -w '%{http_code}' "${BASE}/")
CIBLE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_AUTRE}" -w '%{redirect_url}' "${BASE}/")
case "${CODE}:${CIBLE}" in
  302:*/refus) echo "   session d'un autre identifiant : refusée vers ${CIBLE}" ;;
  *) echo "une session scellée d'un autre identifiant a été acceptée (${CODE} ${CIBLE})"; exit 1 ;;
esac
CODE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_AUTRE}" -w '%{http_code}' "${BASE}/api/moi")
if [ "$CODE" != "401" ]; then echo "route de données : attendu 401 pour un autre identifiant, obtenu $CODE"; exit 1; fi
echo "   route de données : 401"
CODE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_BONNE}" -w '%{http_code}' "${BASE}/")
if [ "$CODE" != "200" ]; then echo "le compte autorisé devrait entrer, obtenu $CODE"; exit 1; fi
echo "   session du compte autorisé : 200"

# La seconde porte publique (tranche 6) : elle répond sans session, et refuse
# tout ce qui n'est pas authentifié. Un garde-fou qui ne refuse jamais n'est pas
# prouvé — on éprouve donc surtout les cas qui doivent échouer.
echo "== la porte des hooks refuse ce qui n'est pas authentifié"
poster() { # $1 = secret porté, $2 = corps
  curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST \
    -H 'content-type: application/json' -H "x-cairn-hooks-secret: $1" \
    -d "$2" "${BASE}/hooks/claude-code"
}
MSG_BON='{"cle":"claude-code:epreuve-1","evenement":"Stop","session":"s-epreuve","depot":"cairn-dashboard","outil":null,"motif":null,"agent":null,"horodatage":"2026-09-16T12:00:00.000Z"}'

CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST "${BASE}/hooks/claude-code")
if [ "$CODE" != "401" ]; then echo "sans secret : attendu 401, obtenu $CODE — $(cat /tmp/smoke-corps)"; exit 1; fi
echo "   sans secret : 401 · $(cat /tmp/smoke-corps)"

CODE=$(poster "un-secret-qui-n-est-pas-le-bon" "$MSG_BON")
if [ "$CODE" != "401" ]; then echo "mauvais secret : attendu 401, obtenu $CODE"; exit 1; fi
echo "   mauvais secret : 401"

CODE=$(poster "$SECRET_HOOKS" "$(echo "$MSG_BON" | sed 's/"Stop"/"PreToolUse"/')")
if [ "$CODE" != "422" ]; then echo "événement hors liste : attendu 422, obtenu $CODE"; exit 1; fi
echo "   événement hors liste : 422 · $(cat /tmp/smoke-corps)"

CODE=$(poster "$SECRET_HOOKS" "$(echo "$MSG_BON" | sed 's/cairn-dashboard/un-autre-projet/')")
if [ "$CODE" != "422" ]; then echo "dépôt inconnu : attendu 422, obtenu $CODE"; exit 1; fi
echo "   dépôt inconnu : 422 · $(cat /tmp/smoke-corps)"

CODE=$(poster "$SECRET_HOOKS" "$MSG_BON")
if [ "$CODE" != "200" ]; then echo "message conforme : attendu 200, obtenu $CODE — $(cat /tmp/smoke-corps)"; exit 1; fi
echo "   message conforme : 200 · $(cat /tmp/smoke-corps)"

CODE=$(poster "$SECRET_HOOKS" "$MSG_BON")
if [ "$CODE" != "200" ]; then echo "même clé renvoyée : attendu 200, obtenu $CODE"; exit 1; fi
case "$(cat /tmp/smoke-corps)" in
  *'"doublon":true'*) echo "   même clé renvoyée : écartée par la base" ;;
  *) echo "une clé déjà connue aurait dû être écartée : $(cat /tmp/smoke-corps)"; exit 1 ;;
esac

# Le connecteur MCP (fiche 0011) : sa découverte, ses refus, puis le parcours
# complet — consentement du compte autorisé, code contre jetons, appel MCP,
# rotation du jeton de rafraîchissement. Rien n'est écrit dans cairn-wms : seuls
# les outils de lecture sont appelés.
echo "== le connecteur MCP se découvre, et refuse ce qui n'est pas autorisé"
verifier_code /.well-known/oauth-protected-resource/mcp 200 "métadonnées de ressource"
case "$(cat /tmp/smoke-corps)" in
  *"\"resource\":\"${BASE}/mcp\""*) echo "   ressource : ${BASE}/mcp" ;;
  *) echo "les métadonnées devraient désigner ${BASE}/mcp : $(cat /tmp/smoke-corps)"; exit 1 ;;
esac
verifier_code /.well-known/oauth-authorization-server 200 "métadonnées du serveur d'autorisation"
case "$(cat /tmp/smoke-corps)" in
  *'"code_challenge_methods_supported":["S256"]'*) echo "   PKCE S256 annoncé" ;;
  *) echo "les métadonnées devraient annoncer S256 : $(cat /tmp/smoke-corps)"; exit 1 ;;
esac

DEFI_MCP=$(curl -s -o /tmp/smoke-corps -m 10 -D - -X POST -H 'content-type: application/json' \
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize"}' "${BASE}/mcp" | tr -d '\r' | grep -i '^www-authenticate:' || true)
CODE=$(curl -s -o /dev/null -m 10 -w '%{http_code}' -X POST -H 'content-type: application/json' -d '{}' "${BASE}/mcp")
case "${CODE}:${DEFI_MCP}" in
  401:*resource_metadata=*) echo "   sans jeton : 401 · ${DEFI_MCP#*: }" ;;
  *) echo "sans jeton, le serveur MCP devrait répondre 401 avec WWW-Authenticate (obtenu ${CODE} ${DEFI_MCP})"; exit 1 ;;
esac
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/json' \
  -H 'authorization: Bearer n.importe.quoi' -d '{}' "${BASE}/mcp")
if [ "$CODE" != "401" ]; then echo "jeton bidon : attendu 401, obtenu $CODE"; exit 1; fi
echo "   jeton bidon : 401 · $(cat /tmp/smoke-corps)"
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/x-www-form-urlencoded' \
  -d "grant_type=authorization_code&client_id=autre&code=x&code_verifier=y" "${BASE}/oauth/jeton")
case "${CODE}:$(cat /tmp/smoke-corps)" in
  401:*invalid_client*) echo "   client inconnu au jeton : 401 invalid_client" ;;
  *) echo "un client inconnu devrait recevoir 401 invalid_client (obtenu ${CODE} $(cat /tmp/smoke-corps))"; exit 1 ;;
esac
CODE=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "${BASE}/oauth/autoriser?client_id=autre&redirect_uri=${RAPPEL_CLAUDE}&response_type=code")
if [ "$CODE" != "400" ]; then echo "un client inconnu à l'autorisation devrait être refusé sur place (400), obtenu $CODE"; exit 1; fi
echo "   client inconnu à l'autorisation : 400, sans redirection"

echo "== le parcours OAuth du connecteur, de bout en bout"
VERIFICATEUR=$(head -c 48 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n')
DEFI=$(printf '%s' "$VERIFICATEUR" | openssl dgst -sha256 -binary | base64 | tr '+/' '-_' | tr -d '=\n')
AUTORISER="${BASE}/oauth/autoriser?client_id=${CLIENT_MCP}&redirect_uri=${RAPPEL_CLAUDE}&response_type=code&code_challenge=${DEFI}&code_challenge_method=S256&resource=${BASE}/mcp&state=etat-epreuve"
CIBLE=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' "$AUTORISER")
case "$CIBLE" in
  */auth/github?retour=*) echo "   sans session : mène à la connexion, avec retour" ;;
  *) echo "sans session, l'autorisation devrait mener à la connexion (obtenu '${CIBLE}')"; exit 1 ;;
esac
curl -s -o /dev/null -m 10 -D /tmp/smoke-entetes -b "cairn_session=${SESSION_BONNE}" "$AUTORISER"
COOKIE_DEMANDE=$(tr -d '\r' < /tmp/smoke-entetes | grep -i '^set-cookie: cairn_mcp_demande=' | head -1 | sed 's/^[Ss]et-[Cc]ookie: //; s/;.*//')
case "$(tr -d '\r' < /tmp/smoke-entetes | grep -i '^location:')" in
  *"/connecteur/consentement"*) [ -n "$COOKIE_DEMANDE" ] && echo "   avec la session du compte autorisé : vers le consentement, demande scellée" ;;
  *) echo "avec session, l'autorisation devrait mener au consentement : $(grep -i '^location:' /tmp/smoke-entetes)"; exit 1 ;;
esac
CODE=$(curl -s -o /dev/null -m 10 -w '%{http_code}' -X POST -b "cairn_session=${SESSION_BONNE}; ${COOKIE_DEMANDE}" \
  -H 'content-type: application/x-www-form-urlencoded' -d 'decision=accepter' "${BASE}/oauth/autoriser")
if [ "$CODE" != "403" ]; then echo "un consentement sans origine devrait être refusé (403), obtenu $CODE"; exit 1; fi
echo "   consentement sans origine : 403"
RETOUR=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' -X POST -b "cairn_session=${SESSION_BONNE}; ${COOKIE_DEMANDE}" \
  -H "origin: ${BASE}" -H 'content-type: application/x-www-form-urlencoded' -d 'decision=accepter' "${BASE}/oauth/autoriser")
CODE_OAUTH=$(printf '%s' "$RETOUR" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')
case "$RETOUR" in
  "${RAPPEL_CLAUDE}?"*state=etat-epreuve*) [ -n "$CODE_OAUTH" ] && echo "   consentement accordé : code renvoyé vers claude.ai avec l'état" ;;
  *) echo "le consentement devrait renvoyer un code vers ${RAPPEL_CLAUDE} (obtenu '${RETOUR}')"; exit 1 ;;
esac
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/x-www-form-urlencoded' \
  -d "grant_type=authorization_code&client_id=${CLIENT_MCP}&code=${CODE_OAUTH}&code_verifier=faux-verificateur-faux-verificateur-faux-verificateur-faux&redirect_uri=${RAPPEL_CLAUDE}" "${BASE}/oauth/jeton")
case "${CODE}:$(cat /tmp/smoke-corps)" in
  400:*invalid_grant*) echo "   mauvais vérificateur PKCE : invalid_grant, code consommé" ;;
  *) echo "un mauvais vérificateur devrait rendre invalid_grant (obtenu ${CODE} $(cat /tmp/smoke-corps))"; exit 1 ;;
esac
# Le code est consommé : nouveau consentement pour un code propre.
curl -s -o /dev/null -m 10 -D /tmp/smoke-entetes -b "cairn_session=${SESSION_BONNE}" "$AUTORISER"
COOKIE_DEMANDE=$(tr -d '\r' < /tmp/smoke-entetes | grep -i '^set-cookie: cairn_mcp_demande=' | head -1 | sed 's/^[Ss]et-[Cc]ookie: //; s/;.*//')
RETOUR=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' -X POST -b "cairn_session=${SESSION_BONNE}; ${COOKIE_DEMANDE}" \
  -H "origin: ${BASE}" -H 'content-type: application/x-www-form-urlencoded' -d 'decision=accepter' "${BASE}/oauth/autoriser")
CODE_OAUTH=$(printf '%s' "$RETOUR" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/x-www-form-urlencoded' \
  -d "grant_type=authorization_code&client_id=${CLIENT_MCP}&code=${CODE_OAUTH}&code_verifier=${VERIFICATEUR}&redirect_uri=${RAPPEL_CLAUDE}&resource=${BASE}/mcp" "${BASE}/oauth/jeton")
if [ "$CODE" != "200" ]; then echo "l'échange du code devrait réussir (obtenu ${CODE} $(cat /tmp/smoke-corps))"; exit 1; fi
ACCES=$(sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p' /tmp/smoke-corps)
RAFRAICHISSEMENT=$(sed -n 's/.*"refresh_token":"\([^"]*\)".*/\1/p' /tmp/smoke-corps)
[ -n "$ACCES" ] && [ -n "$RAFRAICHISSEMENT" ] || { echo "jetons absents de la réponse : $(cat /tmp/smoke-corps)"; exit 1; }
echo "   code échangé : jeton d'accès et jeton de rafraîchissement"
CODE=$(curl -s -o /tmp/smoke-corps -m 20 -w '%{http_code}' -X POST -H 'content-type: application/json' \
  -H 'accept: application/json, text/event-stream' -H "authorization: Bearer ${ACCES}" \
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' "${BASE}/mcp")
case "${CODE}:$(cat /tmp/smoke-corps)" in
  200:*lister_documents*lire_document*ecrire_document*) echo "   tools/list avec le jeton : les trois outils" ;;
  *) echo "tools/list devrait rendre les trois outils (obtenu ${CODE} $(head -c 300 /tmp/smoke-corps))"; exit 1 ;;
esac
CODE=$(curl -s -o /tmp/smoke-corps -m 20 -w '%{http_code}' -X POST -H 'content-type: application/json' \
  -H 'accept: application/json, text/event-stream' -H "authorization: Bearer ${ACCES}" \
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"lister_documents","arguments":{}}}' "${BASE}/mcp")
case "${CODE}:$(cat /tmp/smoke-corps)" in
  200:*".md"*) echo "   lister_documents : l'arbre réel de docs/" ;;
  *) echo "lister_documents devrait rendre des documents (obtenu ${CODE} $(head -c 300 /tmp/smoke-corps))"; exit 1 ;;
esac
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/x-www-form-urlencoded' \
  -d "grant_type=refresh_token&client_id=${CLIENT_MCP}&refresh_token=${RAFRAICHISSEMENT}" "${BASE}/oauth/jeton")
NOUVEAU=$(sed -n 's/.*"refresh_token":"\([^"]*\)".*/\1/p' /tmp/smoke-corps)
if [ "$CODE" != "200" ] || [ -z "$NOUVEAU" ] || [ "$NOUVEAU" = "$RAFRAICHISSEMENT" ]; then
  echo "le rafraîchissement devrait tourner le jeton (obtenu ${CODE} $(head -c 200 /tmp/smoke-corps))"; exit 1
fi
echo "   rafraîchissement : jeton tourné"
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/x-www-form-urlencoded' \
  -d "grant_type=refresh_token&client_id=${CLIENT_MCP}&refresh_token=${RAFRAICHISSEMENT}" "${BASE}/oauth/jeton")
case "${CODE}:$(cat /tmp/smoke-corps)" in
  400:*invalid_grant*) echo "   ancien jeton représenté : invalid_grant" ;;
  *) echo "un jeton déjà tourné devrait être refusé (obtenu ${CODE} $(cat /tmp/smoke-corps))"; exit 1 ;;
esac
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST -H 'content-type: application/x-www-form-urlencoded' \
  -d "grant_type=refresh_token&client_id=${CLIENT_MCP}&refresh_token=${NOUVEAU}" "${BASE}/oauth/jeton")
case "${CODE}:$(cat /tmp/smoke-corps)" in
  400:*invalid_grant*) echo "   famille révoquée après le rejeu : le nouveau ne vaut plus" ;;
  *) echo "après un rejeu, toute la famille devrait être révoquée (obtenu ${CODE} $(cat /tmp/smoke-corps))"; exit 1 ;;
esac

echo "== configuration de connexion incomplète : l'application se déclare malsaine"
demarrer "${NUXT_GITHUB_TOKEN}" "trop-court-16car"
attendre
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' "${BASE}/health")
if [ "$CODE" != "503" ]; then
  echo "un secret de session tronqué devrait rendre /health malsain : obtenu $CODE — $(cat /tmp/smoke-corps)"
  exit 1
fi
echo "   /health : 503 · $(cat /tmp/smoke-corps)"
verifier_code /auth/github 503 "connexion refusée franchement"

# La base est la seule donnée propre du dashboard : un emplacement non
# inscriptible doit se voir au démarrage, pas au premier webhook perdu.
echo "== base inaccessible : /health répond 503, /live tient"
nettoyer
docker run -d --name "$NOM" -p "127.0.0.1:${PORT}:3000" \
  -e "NUXT_GITHUB_TOKEN=${NUXT_GITHUB_TOKEN}" \
  -e "NUXT_GITHUB_REPO=${NUXT_GITHUB_REPO:-}" \
  -e "NUXT_SESSION_PASSWORD=${MDP_SESSION}" \
  -e "NUXT_ALLOWED_GITHUB_ID=${ID_AUTORISE}" \
  -e "NUXT_OAUTH_GITHUB_CLIENT_ID=epreuve" \
  -e "NUXT_OAUTH_GITHUB_CLIENT_SECRET=epreuve" \
  -e "NUXT_BASE_FICHIER=/interdit/cairn.db" \
  "$IMAGE" >/dev/null
attendre
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' "${BASE}/health")
if [ "$CODE" != "503" ]; then
  echo "une base inaccessible devrait rendre /health malsain : obtenu $CODE — $(cat /tmp/smoke-corps)"
  exit 1
fi
echo "   /health : 503 · $(cat /tmp/smoke-corps)"
case "$(cat /tmp/smoke-corps)" in
  *'"connecteur":"client-absent"'*) echo "   connecteur non configuré : signalé" ;;
  *) echo "sans NUXT_MCP_CLIENT_ID, /health devrait signaler le connecteur : $(cat /tmp/smoke-corps)"; exit 1 ;;
esac
verifier_code /live 200 "/live"

# Ce conteneur-ci n'a pas de secret de hooks : la porte doit se déclarer non
# configurée plutôt que d'accepter quoi que ce soit.
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST "${BASE}/hooks/claude-code")
if [ "$CODE" != "503" ]; then
  echo "sans secret configuré, la porte des hooks devrait rendre 503 : obtenu $CODE — $(cat /tmp/smoke-corps)"
  exit 1
fi
echo "   hooks sans secret configuré : 503 · $(cat /tmp/smoke-corps)"

echo "== dépendance coupée : /health répond 503"
demarrer "jeton-invalide-pour-l-epreuve"
attendre
verifier_code /health 503 "/health"
echo "   $(cat /tmp/smoke-corps)"

# Le garde-fou du contrôle de santé du conteneur : GitHub est hors jeu, le
