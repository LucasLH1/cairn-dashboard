#!/usr/bin/env bash
# Épreuve de l'image avant publication — docs/deploiement.md §1 et §2 :
# démarrage réel, /version rend CE SHA, /health répond 200 avec ses dépendances,
# puis 503 une fois une dépendance coupée. Un garde-fou qui ne refuse jamais
# n'est pas prouvé.
#
# Depuis la tranche 1b, on éprouve aussi la porte : sans session, une page mène
# à la connexion, et seules les routes publiques répondent.
#
#   scripts/ci/smoke <image> <sha>
#
# Variables attendues : NUXT_GITHUB_TOKEN, NUXT_GITHUB_REPO (cas nominal).
set -euo pipefail

IMAGE="${1:?image attendue}"
SHA="${2:?sha attendu}"
PORT="${SMOKE_PORT:-3010}"
NOM="smoke-$$"
BASE="http://127.0.0.1:${PORT}"

nettoyer() { docker rm -f "$NOM" >/dev/null 2>&1 || true; }
trap nettoyer EXIT

MDP_SESSION="$(head -c 48 /dev/urandom | base64 | tr -d '\n')"
ID_AUTORISE=68059501
SECRET_HOOKS="$(head -c 32 /dev/urandom | base64 | tr -d '\n')"

# Adresses de GitHub substituables en développement seulement (fiche 0010). Le
# conteneur nominal les reçoit, pointées vers une adresse où rien n'écoute :
# l'image doit les ignorer. Si elle les suivait, /health tomberait à 503 et la
# connexion ne mènerait plus chez GitHub — les deux vérifications ci-dessous le
# verraient.
LEURRE="http://127.0.0.1:9"

# Identifiants OAuth factices : ils ne servent qu'à rendre la configuration
# complète. Aucun appel n'est fait chez GitHub pendant l'épreuve.
demarrer() { # $1 = jeton de lecture, $2 = secret de session (défaut : le bon)
  nettoyer
  docker run -d --name "$NOM" -p "127.0.0.1:${PORT}:3000" \
    -e "NUXT_GITHUB_TOKEN=$1" \
    -e "NUXT_GITHUB_REPO=${NUXT_GITHUB_REPO:-}" \
    -e "NUXT_SESSION_PASSWORD=${2:-$MDP_SESSION}" \
    -e "NUXT_ALLOWED_GITHUB_ID=${ID_AUTORISE}" \
    -e "NUXT_OAUTH_GITHUB_CLIENT_ID=epreuve" \
    -e "NUXT_OAUTH_GITHUB_CLIENT_SECRET=epreuve" \
    -e "NUXT_HOOKS_SECRET=${SECRET_HOOKS}" \
    -e "NUXT_GITHUB_API_URL=${LEURRE}" \
    -e "NUXT_GITHUB_WEB_URL=${LEURRE}" \
    "$IMAGE" >/dev/null
}

# Forge une session scellée comme le serveur le ferait, pour éprouver le
# garde-fou : un sceau valide ne doit pas suffire à entrer.
forger_session() { # $1 = identifiant numérique
  MDP="$MDP_SESSION" ID="$1" node --input-type=module -e '
    import { seal, defaults } from "iron-webcrypto"
    import { webcrypto } from "node:crypto"
    const id = Number(process.env.ID)
    process.stdout.write(await seal(
      webcrypto,
      { id: `epreuve-${id}`, createdAt: Date.now(), data: { id, login: "compte-eprouve" } },
      process.env.MDP,
      { ...defaults, ttl: 12 * 3600 * 1000 },
    ))
  '
}

attendre() {
  for _ in $(seq 1 60); do
    if curl -sf -m 3 -o /dev/null "${BASE}/version"; then return 0; fi
    sleep 1
  done
  echo "le conteneur ne répond pas sur ${BASE}/version"; docker logs "$NOM" | tail -20; return 1
}

verifier_code() { # $1 = chemin, $2 = code attendu, $3 = libellé
  local code
  code=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' "${BASE}$1")
  if [ "$code" != "$2" ]; then
    echo "$3 : attendu $2, obtenu $code — $(head -c 200 /tmp/smoke-corps)"
    docker logs "$NOM" | tail -20
    exit 1
  fi
  echo "   $3 : $code"
}

echo "== démarrage de l'image avec un jeton valide"
demarrer "${NUXT_GITHUB_TOKEN:?jeton attendu}"
attendre

echo "== /version rend le SHA construit"
VU=$(curl -sf -m 5 "${BASE}/version" | sed -n 's/.*"commit" *: *"\([^"]*\)".*/\1/p')
if [ "$VU" != "$SHA" ]; then echo "attendu $SHA, obtenu '${VU}'"; exit 1; fi
echo "   $VU"

echo "== /health répond 200"
verifier_code /health 200 "/health"
echo "   $(cat /tmp/smoke-corps)"

echo "== /live répond 200"
verifier_code /live 200 "/live"
echo "   $(cat /tmp/smoke-corps)"

echo "== sans session, la porte est fermée"
verifier_code / 302 "page d'accueil"
CIBLE=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' "${BASE}/")
case "$CIBLE" in
  */connexion) echo "   redirige vers $CIBLE" ;;
  *) echo "la page d'accueil devrait mener à /connexion, elle mène à '${CIBLE}'"; exit 1 ;;
esac
verifier_code /connexion 200 "écran de connexion"
verifier_code /api/moi 401 "route de données"
CIBLE=$(curl -s -o /dev/null -m 10 -w '%{redirect_url}' "${BASE}/auth/github")
case "$CIBLE" in
  https://github.com/login/oauth/authorize*) echo "   connexion configurée : part chez GitHub" ;;
  *) echo "la connexion devrait mener chez GitHub, elle mène à '${CIBLE}'"; exit 1 ;;
esac
echo "   adresses de développement reçues et ignorées : /health a lu le vrai GitHub, la connexion y mène"

echo "== un sceau valide ne suffit pas : l'identifiant est revérifié"
SESSION_AUTRE="$(forger_session 999999)"
SESSION_BONNE="$(forger_session "$ID_AUTORISE")"
CODE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_AUTRE}" -w '%{http_code}' "${BASE}/")
CIBLE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_AUTRE}" -w '%{redirect_url}' "${BASE}/")
case "${CODE}:${CIBLE}" in
  302:*/refus) echo "   session d'un autre identifiant : refusée vers ${CIBLE}" ;;
  *) echo "une session scellée d'un autre identifiant a été acceptée (${CODE} ${CIBLE})"; exit 1 ;;
esac
CODE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_AUTRE}" -w '%{http_code}' "${BASE}/api/moi")
if [ "$CODE" != "401" ]; then echo "route de données : attendu 401 pour un autre identifiant, obtenu $CODE"; exit 1; fi
echo "   route de données : 401"
CODE=$(curl -s -o /dev/null -m 10 -b "cairn_session=${SESSION_BONNE}" -w '%{http_code}' "${BASE}/")
if [ "$CODE" != "200" ]; then echo "le compte autorisé devrait entrer, obtenu $CODE"; exit 1; fi
echo "   session du compte autorisé : 200"

# La seconde porte publique (tranche 6) : elle répond sans session, et refuse
# tout ce qui n'est pas authentifié. Un garde-fou qui ne refuse jamais n'est pas
# prouvé — on éprouve donc surtout les cas qui doivent échouer.
echo "== la porte des hooks refuse ce qui n'est pas authentifié"
poster() { # $1 = secret porté, $2 = corps
  curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST \
    -H 'content-type: application/json' -H "x-cairn-hooks-secret: $1" \
    -d "$2" "${BASE}/hooks/claude-code"
}
MSG_BON='{"cle":"claude-code:epreuve-1","evenement":"Stop","session":"s-epreuve","depot":"cairn-dashboard","outil":null,"motif":null,"agent":null,"horodatage":"2026-09-16T12:00:00.000Z"}'

CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST "${BASE}/hooks/claude-code")
if [ "$CODE" != "401" ]; then echo "sans secret : attendu 401, obtenu $CODE — $(cat /tmp/smoke-corps)"; exit 1; fi
echo "   sans secret : 401 · $(cat /tmp/smoke-corps)"

CODE=$(poster "un-secret-qui-n-est-pas-le-bon" "$MSG_BON")
if [ "$CODE" != "401" ]; then echo "mauvais secret : attendu 401, obtenu $CODE"; exit 1; fi
echo "   mauvais secret : 401"

CODE=$(poster "$SECRET_HOOKS" "$(echo "$MSG_BON" | sed 's/"Stop"/"PreToolUse"/')")
if [ "$CODE" != "422" ]; then echo "événement hors liste : attendu 422, obtenu $CODE"; exit 1; fi
echo "   événement hors liste : 422 · $(cat /tmp/smoke-corps)"

CODE=$(poster "$SECRET_HOOKS" "$(echo "$MSG_BON" | sed 's/cairn-dashboard/un-autre-projet/')")
if [ "$CODE" != "422" ]; then echo "dépôt inconnu : attendu 422, obtenu $CODE"; exit 1; fi
echo "   dépôt inconnu : 422 · $(cat /tmp/smoke-corps)"

CODE=$(poster "$SECRET_HOOKS" "$MSG_BON")
if [ "$CODE" != "200" ]; then echo "message conforme : attendu 200, obtenu $CODE — $(cat /tmp/smoke-corps)"; exit 1; fi
echo "   message conforme : 200 · $(cat /tmp/smoke-corps)"

CODE=$(poster "$SECRET_HOOKS" "$MSG_BON")
if [ "$CODE" != "200" ]; then echo "même clé renvoyée : attendu 200, obtenu $CODE"; exit 1; fi
case "$(cat /tmp/smoke-corps)" in
  *'"doublon":true'*) echo "   même clé renvoyée : écartée par la base" ;;
  *) echo "une clé déjà connue aurait dû être écartée : $(cat /tmp/smoke-corps)"; exit 1 ;;
esac

echo "== configuration de connexion incomplète : l'application se déclare malsaine"
demarrer "${NUXT_GITHUB_TOKEN}" "trop-court-16car"
attendre
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' "${BASE}/health")
if [ "$CODE" != "503" ]; then
  echo "un secret de session tronqué devrait rendre /health malsain : obtenu $CODE — $(cat /tmp/smoke-corps)"
  exit 1
fi
echo "   /health : 503 · $(cat /tmp/smoke-corps)"
verifier_code /auth/github 503 "connexion refusée franchement"

# La base est la seule donnée propre du dashboard : un emplacement non
# inscriptible doit se voir au démarrage, pas au premier webhook perdu.
echo "== base inaccessible : /health répond 503, /live tient"
nettoyer
docker run -d --name "$NOM" -p "127.0.0.1:${PORT}:3000" \
  -e "NUXT_GITHUB_TOKEN=${NUXT_GITHUB_TOKEN}" \
  -e "NUXT_GITHUB_REPO=${NUXT_GITHUB_REPO:-}" \
  -e "NUXT_SESSION_PASSWORD=${MDP_SESSION}" \
  -e "NUXT_ALLOWED_GITHUB_ID=${ID_AUTORISE}" \
  -e "NUXT_OAUTH_GITHUB_CLIENT_ID=epreuve" \
  -e "NUXT_OAUTH_GITHUB_CLIENT_SECRET=epreuve" \
  -e "NUXT_BASE_FICHIER=/interdit/cairn.db" \
  "$IMAGE" >/dev/null
attendre
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' "${BASE}/health")
if [ "$CODE" != "503" ]; then
  echo "une base inaccessible devrait rendre /health malsain : obtenu $CODE — $(cat /tmp/smoke-corps)"
  exit 1
fi
echo "   /health : 503 · $(cat /tmp/smoke-corps)"
verifier_code /live 200 "/live"

# Ce conteneur-ci n'a pas de secret de hooks : la porte doit se déclarer non
# configurée plutôt que d'accepter quoi que ce soit.
CODE=$(curl -s -o /tmp/smoke-corps -m 10 -w '%{http_code}' -X POST "${BASE}/hooks/claude-code")
if [ "$CODE" != "503" ]; then
  echo "sans secret configuré, la porte des hooks devrait rendre 503 : obtenu $CODE — $(cat /tmp/smoke-corps)"
  exit 1
fi
echo "   hooks sans secret configuré : 503 · $(cat /tmp/smoke-corps)"

echo "== dépendance coupée : /health répond 503"
demarrer "jeton-invalide-pour-l-epreuve"
attendre
verifier_code /health 503 "/health"
echo "   $(cat /tmp/smoke-corps)"

# Le garde-fou du contrôle de santé du conteneur : GitHub est hors jeu, le
# service n'est pas utilisable — mais le processus, lui, répond. Si /live
# tombait ici, une panne chez GitHub ferait redémarrer le conteneur en boucle.
echo "== /live tient malgré la dépendance coupée"
verifier_code /live 200 "/live"
echo "   $(cat /tmp/smoke-corps)"

echo "== image éprouvée"
